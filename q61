class Solution {
public:
    ListNode* rotateRight(ListNode* head, int k) {
        if (!head || !head->next) return head;

        ListNode* temp = head;
        int n = 1;

        while (temp->next) {
            temp = temp->next;
            n++;
        }

        k = k % n;
        if (k == 0) return head;

        temp->next = head;

        int steps = n - k;
        while (steps--) {
            temp = temp->next;
        }

        head = temp->next;
        temp->next = nullptr;

        return head;
    }
};
